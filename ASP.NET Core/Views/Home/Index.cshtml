@using ASP_NET_Core.Models
@model Employee

<style type="text/css">
    #form-avatar {
        height: 128px;
        width: 128px;
    }
</style>

<script type="text/javascript">
    function valueChanged(e, component, dataField) {
        component.updateData(dataField, e.value);
    }

    function validateClick() {
        const validationResult = DevExpress.validationEngine.validateGroup('formGroup');

        if (!validationResult.isValid) {
            DevExpress.ui.notify('dxForm is invalid', 'error', 2000);
        }
    }
</script>

@using (Html.DevExtreme().ValidationGroup("formGroup"))
{

    @(Html.DevExtreme().Form<Employee>()
    .FormData(Model)
    .ValidationGroup("formGroup")
    .Items(items =>
    {
    items.AddSimpleFor(m => m.FirstName);
    items.AddSimpleFor(m => m.LastName)
    .IsRequired(true)
    .Template(@<text>
        <div>
            @(Html.DevExtreme().TextBoxFor(m => m.LastName)
                    .OnValueChanged("function(e) { valueChanged(e, component, dataField); }")
                    )
        </div>
    </text>);
    items.AddSimpleFor(m => m.Photo)
    .Template(@<text>
        <img id="form-avatar" src="<%- component.option('formData')[dataField] %>" alt="employee" />
    </text>);
    items.AddButton()
        .HorizontalAlignment(HorizontalAlignment.Left)
        .ButtonOptions(b => b
            .Text("Validate")
            .Type(ButtonType.Success)
            .OnClick("validateClick")
        );
    })
)

}